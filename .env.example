# ===== قالب إعدادات نظام إدارة المستشفيات — انسخه إلى .env وعدّل =====
#   copy .env.example .env        (ويندوز)
#   cp .env.example .env          (لينكس)
# ثم عدّل القيم أدناه. docker compose يقرأ .env تلقائيًا لاستبدال ${...}.

# إلزامي: مفتاح توقيع JWT — أنشئ قيمة عشوائية طويلة، مثال:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=

# قاعدة البيانات: اتركها معلّقة لـSQLite (الافتراضي).
# عند استخدام docker-compose.pg.yml يُضبط تلقائيًا — لا داعي لتفعيلها.
# DATABASE_URL=postgresql://USER:PASS@db:5432/DBNAME

# البريد — MAIL_ENABLED=false يحفظ الرسائل في outbox/ بدل الإرسال
MAIL_ENABLED=false
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# MAIL_FROM=noreply@hospital.com
# MAIL_USE_TLS=true

# الوصول — قيّدها في الإنتاج (مثال: https://your-domain.com)
CORS_ORIGINS=*
ACCESS_TOKEN_EXPIRE_MINUTES=30

# دورية تذكير المواعيد بالدقائق (0 لتعطيلها)
REMINDER_INTERVAL_MINUTES=5
REMINDER_HOURS_BEFORE=24

# ===== نسخ احتياطي تلقائي مجدول (SQLite فقط؛ 0 لتعطيله) =====
# BACKUP_INTERVAL_HOURS=24
# BACKUP_RETENTION=7

# ===== إشعارات فورية اختيارية (تلغرام و/أو ويبهوك) =====
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# NOTIFY_WEBHOOK_URL=

# ===== حماية الدخول (قفل بعد محاولات فاشلة — 0 يُعطل القفل) =====
# LOGIN_MAX_ATTEMPTS=5
# LOGIN_LOCKOUT_MINUTES=15
# AUTH_IP_FAIL_MAX=30        # 0 لتعطيل حد الـIP
# AUTH_IP_WINDOW_MINUTES=15
