# ===== قالب نشر إنتاجي — خادم حقيقي: SMTP فعلي + نطاق CORS مقيّد =====
# الاستخدام:
#   (طريقة أ) انسخه إلى .env على خادم الإنتاج ثم:  docker compose up -d app
#   (طريقة ب) استخدمه مباشرة:  docker compose --env-file .env.production -f docker-compose.yml up -d app
# ⚠️ املأ كل الفراغات — لا يُشارك الملف بعد ملئه. الفحص بعد التشغيل:
#   BASE_URL=https://your-domain python tests/stack_check.py

# — الأمان (إلزامي) —
# مفتاح JWT عشوائي قوي:  python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
DEBUG=false
# صلاحية الجلسات بالدقائق (120 مناسب لعمل المستشفى دون إعادة دخول متكررة)
ACCESS_TOKEN_EXPIRE_MINUTES=120

# — نطاقات مسموحة (قيّد CORS على نطاقك بدل * في الإنتاج) —
CORS_ORIGINS=https://hospital.example.com

# — قاعدة البيانات —
# اتركها معلّقة لـSQLite (افتراضي آمن مع volumes). لـPostgreSQL استخدم docker-compose.pg.yml
# (يضبط الرابط تلقائيًا) أو عيّن رابطًا برمز قوي:
# DATABASE_URL=postgresql://hospital:CHANGE_ME_STRONG@db:5432/hospital

# — البريد الفعلي: إشعارات وتأكيدات وتذكيرات —
MAIL_ENABLED=true
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASSWORD=
MAIL_FROM=noreply@your-domain.com
MAIL_USE_TLS=true

# — دورية تذكير المواعيد (بالدقائق — 0 لتعطيلها) —
REMINDER_INTERVAL_MINUTES=15
REMINDER_HOURS_BEFORE=24

# — نسخ احتياطي تلقائي مجدول (SQLite فقط — 0 لتعطيله) —
# BACKUP_INTERVAL_HOURS=24
# BACKUP_RETENTION=7

# — إشعارات فورية اختيارية (تلغرام و/أو ويبهوك) —
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=
# NOTIFY_WEBHOOK_URL=

# — حماية الدخول: قفل بعد محاولات فاشلة (0 يُعطل القفل) —
# LOGIN_MAX_ATTEMPTS=5
# LOGIN_LOCKOUT_MINUTES=15
# AUTH_IP_FAIL_MAX=30        # 0 لتعطيل حد الـIP
# AUTH_IP_WINDOW_MINUTES=15
